        },
        {
          "name": "bg_capa.png",
          "path": "bg_capa.png",
          "type": "Image"
        },
        {
          "name": "bg_geral.png",
          "path": "bg_geral.png",
          "type": "Image"
        },
        {
          "name": "bg_classes.png",
          "path": "bg_classes.png",
          "type": "Image"
        },
        {
          "name": "bg_validadores.png",
          "path": "bg_validadores.png",
          "type": "Image"
        }
      ]
    }
  ],
  "settings": {
    "useStylableVisualContainerHeader": true,
    "defaultDrillFilterOtherVisuals": true
