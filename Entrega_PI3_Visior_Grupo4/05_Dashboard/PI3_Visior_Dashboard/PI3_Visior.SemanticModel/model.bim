          }
        ],
        "lineageTag": "f6a86910-e5b0-49d9-93f4-5cdfe9174b55",
        "measures": [
          {
            "name": "Concentração 3 classes",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"Participação de I-O\"))",
            "formatString": "0.0%",
            "lineageTag": "00eb7aa2-a548-4a03-afb1-18c19458cfb1"
          },
          {
            "name": "Economia 50%",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"(% do tempo\"))",
            "formatString": "0.0%",
            "lineageTag": "b59e6683-25f6-4e6c-982c-2178c741a8d2"
          },
          {
            "name": "Correções em I-E",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"terminam em I-E\"))",
            "formatString": "0.0%",
            "lineageTag": "d92c0a22-2a28-4c33-868a-071238f49408"
          },
          {
            "name": "Taxa de correção placas",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"Taxa de correção de classe\"))",
            "formatString": "0.0%",
            "lineageTag": "286ee9b3-f570-423b-ab30-1bdb91b806d4"
          },
          {
            "name": "Ações F1",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"Ações analisadas\"))",
            "formatString": "#,0",
            "lineageTag": "3f61b9d0-fe39-493c-a4e3-42ff6a8f7dcf"
          },
          {
            "name": "Votos F2",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"Votos analisados\"))",
            "formatString": "#,0",
            "lineageTag": "d82af7ae-66e9-42b1-9954-7c5c110edb34"
          },
          {
            "name": "Economia h/mês",
            "expression": "FORMAT(CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"horas/mês\")), \"0.0\") & \" h/mês\"",
            "lineageTag": "cc2bb011-63ea-4b92-aa7c-e1e296744aa4"
          },
          {
            "name": "Tempo corrigir",
            "expression": "FORMAT(CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"para corrigir\")), \"0.0\") & \" s\"",
            "lineageTag": "ba292ca1-2dee-4371-85ea-73ff99de0793"
          },
          {
            "name": "Rejeição geral F2",
            "expression": "CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"rejeição geral\"))",
            "formatString": "0.0%",
            "lineageTag": "fb866c06-b08a-45ef-a2cf-98c345141091"
          },
          {
            "name": "Corrigir x rejeitar",
            "expression": "VAR c = CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"para corrigir\")) VAR r = CALCULATE(MAX(kpis[valor]), CONTAINSSTRING(kpis[indicador], \"para rejeitar\")) RETURN FORMAT(DIVIDE(c, r), \"0.0\") & \"×\"",
            "lineageTag": "dcd7ca45-81a9-48ae-954d-33f42fd85b65"
          }
        ],
        "partitions": [
          {
            "name": "kpis",
            "mode": "import",
